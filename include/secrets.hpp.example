// General secrets template
// Copy this file to `include/secrets.hpp` and set your values.
// `include/secrets.hpp` is git-ignored; this example file is safe to commit.

#ifndef _INCLUDE_SECRETS_HPP_
#define _INCLUDE_SECRETS_HPP_

// Wi-Fi credentials (used to seed NVS on first boot)
#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-password"

// Timezone as POSIX TZ string (used by tzset)
// Format: POSIX TZ, not IANA. If you have an IANA ID like
// "America/New_York", use the equivalent POSIX string.
// Reference: https://github.com/nayarsystems/posix_tz_db/blob/master/zones.csv
// Examples:
//  - Berlin (Europe/Berlin):    "CET-1CEST,M3.5.0,M10.5.0/3"
//  - US Eastern (America/New_York): "EST5EDT,M3.2.0/2,M11.1.0/2"
#define TIMEZONE_TZ "CET-1CEST,M3.5.0,M10.5.0/3"

// Location info (for future features like weather, sunrise/sunset)
#define LOCATION_NAME "Your City, Country"
#define LOCATION_LAT  52.5200    // decimal degrees
#define LOCATION_LON  13.4050    // decimal degrees

// Optional API keys
// OpenWeather: https://openweathermap.org/api
#define OPENWEATHER_API_KEY ""

#endif // _INCLUDE_SECRETS_HPP_
